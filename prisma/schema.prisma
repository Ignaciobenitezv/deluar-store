generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  CREATED
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  CANCELLED
  EXPIRED
  FULFILLED
  REFUNDED
}

enum PaymentMethod {
  GOCUOTAS
  MERCADO_PAGO
  TRANSFER
  GETNET
  UNICOBROS
}

enum PaymentProvider {
  GOCUOTAS
  MERCADO_PAGO
  GETNET
  UNICOBROS
}

enum PaymentStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
  CHARGED_BACK
}

enum AnalyticsEventType {
  SESSION_STARTED
  PAGE_VIEWED
  PRODUCT_VIEWED
  ADD_TO_CART
  REMOVE_FROM_CART
  CART_VIEWED
  CHECKOUT_STARTED
  CHECKOUT_INFO_COMPLETED
  ORDER_CREATED
  PURCHASE_COMPLETED
  CART_ABANDONED
  CHECKOUT_ABANDONED
}

enum AnalyticsCartStatus {
  ACTIVE
  CHECKOUT_STARTED
  ORDER_CREATED
  PURCHASED
  CART_ABANDONED
  CHECKOUT_ABANDONED
}

model Customer {
  id                String            @id @default(uuid()) @db.Uuid
  fullName          String
  email             String
  phone             String
  createdAt         DateTime          @default(now())
  orders            Order[]
  shippingAddresses ShippingAddress[]

  @@index([email])
  @@index([createdAt])
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  role          String     @default("user")
  banned        Boolean    @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  accounts      Account[]
  sessions      Session[]

  @@index([role])
  @@index([createdAt])
  @@map("user")
}

model Session {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  token         String   @unique
  expiresAt     DateTime
  ipAddress     String?
  userAgent     String?
  impersonatedBy String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @db.Uuid
  issuer                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id          String   @id @default(uuid()) @db.Uuid
  identifier   String
  value        String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model ShippingAddress {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  province   String
  city       String
  postalCode String
  address    String
  apartment  String?
  notes      String?
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([customerId])
  @@index([province, city])
}

model ProductSnapshot {
  id              String      @id @default(uuid()) @db.Uuid
  sanityProductId String
  title           String
  slug            String
  price           Decimal     @db.Decimal(12, 2)
  transferPrice   Decimal?    @db.Decimal(12, 2)
  imageUrl        String?
  createdAt       DateTime    @default(now())
  orderItems      OrderItem[]

  @@index([sanityProductId])
  @@index([slug])
  @@index([createdAt])
}

model AnalyticsVisitor {
  id         String            @id @default(uuid()) @db.Uuid
  visitorId  String            @unique @db.Uuid
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  lastSeenAt DateTime
  sessions   AnalyticsSession[]
  events     AnalyticsEvent[]
  carts      AnalyticsCart[]

  @@index([createdAt])
  @@index([lastSeenAt])
}

model AnalyticsSession {
  id          String            @id @default(uuid()) @db.Uuid
  sessionId   String            @unique @db.Uuid
  visitorId   String            @db.Uuid
  startedAt   DateTime          @default(now())
  lastSeenAt  DateTime
  landingPage String
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  visitor     AnalyticsVisitor  @relation(fields: [visitorId], references: [visitorId], onDelete: Cascade)
  events      AnalyticsEvent[]
  carts       AnalyticsCart[]

  @@index([visitorId])
  @@index([startedAt])
  @@index([lastSeenAt])
}

model AnalyticsEvent {
  id         String             @id @default(uuid()) @db.Uuid
  eventId    String             @unique @db.Uuid
  dedupeKey  String?            @unique
  type       AnalyticsEventType
  visitorId  String             @db.Uuid
  sessionId  String             @db.Uuid
  cartId     String?            @db.Uuid
  orderId    String?            @db.Uuid
  productId  String?
  variantId  String?
  path       String?
  url        String?
  metadata   Json?
  createdAt  DateTime           @default(now())
  visitor    AnalyticsVisitor   @relation(fields: [visitorId], references: [visitorId], onDelete: Cascade)
  session    AnalyticsSession   @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  analyticsCart AnalyticsCart?  @relation("AnalyticsCartEvents", fields: [cartId], references: [cartId], onDelete: SetNull)
  order      Order?             @relation("OrderAnalyticsEvents", fields: [orderId], references: [id], onDelete: SetNull)

  @@index([visitorId])
  @@index([sessionId])
  @@index([cartId])
  @@index([orderId])
  @@index([type, createdAt])
  @@index([productId])
  @@index([variantId])
  @@index([createdAt])
}

model AnalyticsCart {
  id                     String               @id @default(uuid()) @db.Uuid
  cartId                 String               @unique @db.Uuid
  visitorId              String               @db.Uuid
  sessionId              String?              @db.Uuid
  status                 AnalyticsCartStatus  @default(ACTIVE)
  itemCount              Int                  @default(0)
  subtotal               Decimal              @default(0) @db.Decimal(12, 2)
  itemsSnapshot          Json
  lastActivityAt         DateTime
  checkoutStartedAt      DateTime?
  checkoutInfoCompletedAt DateTime?
  convertedOrderId       String?              @unique @db.Uuid
  convertedAt            DateTime?
  purchaseCompletedAt    DateTime?
  abandonedAt            DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  visitor                AnalyticsVisitor     @relation(fields: [visitorId], references: [visitorId], onDelete: Cascade)
  session                AnalyticsSession?    @relation(fields: [sessionId], references: [sessionId], onDelete: SetNull)
  convertedOrder         Order?               @relation(fields: [convertedOrderId], references: [id], onDelete: SetNull)
  events                 AnalyticsEvent[]     @relation("AnalyticsCartEvents")

  @@index([status])
  @@index([status, lastActivityAt])
  @@index([lastActivityAt])
  @@index([abandonedAt])
  @@index([purchaseCompletedAt])
  @@index([visitorId])
  @@index([sessionId])
  @@index([convertedOrderId])
}

model Product {
  id              String   @id @default(uuid()) @db.Uuid
  sanityProductId String   @unique
  slug            String   @unique
  title           String
  stock           Int      @default(0)
  trackInventory  Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@index([trackInventory, stock])
  @@index([createdAt])
}

model Order {
  id                String           @id @default(uuid()) @db.Uuid
  orderNumber       String           @unique
  status            OrderStatus      @default(CREATED)
  subtotal          Decimal          @db.Decimal(12, 2)
  shippingMethod    String           @default("home_delivery")
  shippingCost      Decimal          @default(0) @db.Decimal(12, 2)
  total             Decimal          @db.Decimal(12, 2)
  paymentMethod     PaymentMethod
  paymentProvider   PaymentProvider?
  paymentStatus     PaymentStatus    @default(NOT_STARTED)
  externalPaymentId String?
  externalReference String?
  providerPreferenceId String?       @unique
  providerPaymentId  String?          @unique
  rawProviderStatus  String?
  checkoutUrl        String?
  installments       Int?
  customerId        String           @db.Uuid
  shippingAddressId String?          @db.Uuid
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  shippingAddress   ShippingAddress? @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  webhookEvents     MercadoPagoWebhookEvent[]
  paymentWebhookEvents PaymentWebhookEvent[]
  emailLogs         EmailLog[]
  analyticsCart     AnalyticsCart?
  analyticsEvents   AnalyticsEvent[]        @relation("OrderAnalyticsEvents")

  @@index([customerId])
  @@index([shippingAddressId])
  @@index([status])
  @@index([paymentStatus])
  @@index([shippingMethod])
  @@index([externalPaymentId])
  @@index([externalReference])
  @@index([providerPreferenceId])
  @@index([providerPaymentId])
  @@index([createdAt])
}

model PaymentWebhookEvent {
  id                String    @id @default(uuid()) @db.Uuid
  provider          String
  dedupeKey         String    @unique
  providerEventId   String?
  providerPaymentId String?
  externalReference String?
  orderId           String?   @db.Uuid
  payload           Json
  headers           Json?
  processedAt       DateTime?
  createdAt         DateTime  @default(now())
  order             Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([provider])
  @@index([providerEventId])
  @@index([providerPaymentId])
  @@index([externalReference])
  @@index([orderId])
  @@index([createdAt])
}

model EmailLog {
  id                String   @id @default(uuid()) @db.Uuid
  eventKey          String   @unique
  orderId           String?  @db.Uuid
  recipient         String
  subject           String
  template          String
  provider          String   @default("resend")
  providerMessageId String?
  createdAt         DateTime @default(now())
  order             Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([recipient])
  @@index([template])
  @@index([createdAt])
}

model OrderItem {
  id                String           @id @default(uuid()) @db.Uuid
  orderId           String           @db.Uuid
  productSnapshotId String?          @db.Uuid
  productId         String
  productName       String
  productSlug       String
  variantId         String?
  variantValue      String?
  variantLabel      String?
  variantAttributes Json?
  variantSku        String?
  quantity          Int
  unitPrice         Decimal          @db.Decimal(12, 2)
  transferPrice     Decimal?         @db.Decimal(12, 2)
  imageUrl          String?
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productSnapshot   ProductSnapshot? @relation(fields: [productSnapshotId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productSnapshotId])
  @@index([productId])
  @@index([productSlug])
}

model MercadoPagoWebhookEvent {
  id                String   @id @default(uuid()) @db.Uuid
  provider          String
  dedupeKey         String   @unique
  providerEventId   String?
  providerPaymentId String?
  externalReference String?
  topic             String?
  action            String?
  orderId           String?  @db.Uuid
  payload           Json
  headers           Json?
  createdAt         DateTime @default(now())
  order             Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([providerEventId])
  @@index([providerPaymentId])
  @@index([externalReference])
  @@index([createdAt])
}
